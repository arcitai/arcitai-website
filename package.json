{
  "name": "arcitai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "review:build": "VITE_REVIEW_PREVIEW=true vite build --outDir output/family-preview",
    "review:preview": "vite preview --outDir output/family-preview --host 127.0.0.1 --port 4183 --strictPort",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "worker:typecheck": "tsc -p tsconfig.worker.json --pretty false",
    "worker:test": "vitest run worker",
    "worker:check": "npm run worker:typecheck && npm run worker:test",
    "worker:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:build": "npm run worker:check && npm run worker:dry-run",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "worker:deploy:recovery": "wrangler deploy --config wrangler.jsonc",
    "worker:secret:put": "wrangler secret put NOTION_TOKEN --config wrangler.jsonc",
    "build": "tsc -b --pretty false && vite build && node scripts/prepare-pages.mjs",
    "check": "npm run format && npm run lint && npm run test && npm run build",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@cloudflare/workers-types": "5.20260921.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "wrangler": "4.138.0"
  }
}
