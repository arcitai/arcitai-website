        {
          "type": "text",
          "id": "n317",
          "name": "FAQ 4 answer",
          "x": 24.0,
          "y": 6094.0,
          "width": 342.0,
          "height": 153.0,
          "content": "Explore onlinesourdough for resources and hands-on guidance. The difference is who takes care of the delivery, not whether security matters.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.43,
          "textGrowth": "fixed-width-height",
          "fill": [
