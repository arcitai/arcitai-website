          "children": []
        },
        {
          "type": "text",
          "id": "n149",
          "name": "FAQ 1 answer",
          "x": 120.0,
          "y": 3083.0,
          "width": 535.0,
          "height": 133.0,
          "content": "Often we can use what you already have — such as Codex or Cursor — with better instructions, skills, tests and review. I recommend additional software only where the work needs it.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.42,
          "textGrowth": "fixed-width-height",
          "fill": [
