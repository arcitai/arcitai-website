              "color": "#615f56"
            }
          ]
        },
        {
          "type": "text",
          "id": "n316",
          "name": "Prefer to build it yourself?",
          "x": 24.0,
          "y": 6028.0,
          "width": 342.0,
          "height": 56.0,
          "content": "Prefer to build it yourself?",
          "fontFamily": "Geist",
          "fontSize": 20.0,
          "fontWeight": 500,
          "lineHeight": 1.35,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#18211d"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "n315",
          "name": "FAQ 4 rule",
          "x": 24.0,
          "y": 6006.0,
          "width": 342.0,
          "height": 1.0,
          "cornerRadius": 0.0,
          "fill": [
            {
              "type": "solid",
              "color": "#b5c6b7"
            }
          ],
          "children": []
        },
        {
          "type": "text",
          "id": "n314",
          "name": "FAQ 3 answer",
          "x": 24.0,
          "y": 5851.0,
          "width": 342.0,
          "height": 153.0,
          "content": "Yes. We agree what I’m responsible for, how changes are reviewed and what ongoing support includes. It can be a focused piece of work or a longer collaboration.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.43,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#615f56"
            }
          ]
        },
        {
          "type": "text",
          "id": "n313",
          "name": "Can you keep looking after it?",
          "x": 24.0,
          "y": 5785.0,
          "width": 342.0,
          "height": 56.0,
          "content": "Can you keep looking after it?",
          "fontFamily": "Geist",
          "fontSize": 20.0,
          "fontWeight": 500,
          "lineHeight": 1.35,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#18211d"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "n312",
          "name": "FAQ 3 rule",
          "x": 24.0,
          "y": 5763.0,
          "width": 342.0,
          "height": 1.0,
          "cornerRadius": 0.0,
          "fill": [
            {
              "type": "solid",
              "color": "#b5c6b7"
            }
          ],
          "children": []
        },
        {
          "type": "text",
          "id": "n311",
          "name": "FAQ 2 answer",
          "x": 24.0,
          "y": 5556.0,
          "width": 342.0,
          "height": 211.0,
          "content": "The code, data access, integrations and the things that could go wrong. We agree the scope, fix relevant findings and check the changes again. Instructions alone don’t enforce permissions, and a review isn’t a guarantee that nothing can go wrong.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.43,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#615f56"
            }
          ]
        },
        {
          "type": "text",
          "id": "n310",
          "name": "What do you check?",
          "x": 24.0,
          "y": 5490.0,
          "width": 342.0,
          "height": 56.0,
          "content": "What do you check?",
          "fontFamily": "Geist",
          "fontSize": 20.0,
          "fontWeight": 500,
          "lineHeight": 1.35,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#18211d"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "n309",
          "name": "FAQ 2 rule",
          "x": 24.0,
          "y": 5468.0,
          "width": 342.0,
          "height": 1.0,
          "cornerRadius": 0.0,
          "fill": [
            {
              "type": "solid",
              "color": "#b5c6b7"
            }
          ],
          "children": []
        },
        {
          "type": "text",
          "id": "n308",
          "name": "FAQ 1 answer",
          "x": 24.0,
          "y": 5321.0,
          "width": 342.0,
          "height": 153.0,
          "content": "Often we can use what you already have — such as Codex or Cursor — with better instructions, skills, tests and review. I recommend additional software only where the work needs it.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.43,
          "textGrowth": "fixed-width-height",
          "fill": [
