        {
          "type": "text",
          "id": "n158",
          "name": "FAQ 4 answer",
          "x": 120.0,
          "y": 3698.0,
          "width": 535.0,
          "height": 133.0,
          "content": "Explore onlinesourdough for resources and hands-on guidance. The difference is who takes care of the delivery, not whether security matters.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.42,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#615f56"
            }
          ]
        },
        {
          "type": "text",
          "id": "n157",
          "name": "Prefer to build it yourself?",
          "x": 120.0,
          "y": 3655.0,
          "width": 535.0,
          "height": 30.0,
          "content": "Prefer to build it yourself?",
          "fontFamily": "Geist",
          "fontSize": 20.0,
          "fontWeight": 500,
          "lineHeight": 1.35,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#18211d"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "n156",
          "name": "FAQ 4 rule",
          "x": 120.0,
          "y": 3639.0,
          "width": 535.0,
          "height": 1.0,
          "cornerRadius": 0.0,
          "fill": [
            {
              "type": "solid",
              "color": "#b5c6b7"
            }
          ],
          "children": []
        },
        {
          "type": "text",
          "id": "n155",
          "name": "FAQ 3 answer",
          "x": 120.0,
          "y": 3513.0,
          "width": 535.0,
          "height": 133.0,
          "content": "Yes. We agree what I’m responsible for, how changes are reviewed and what ongoing support includes. It can be a focused piece of work or a longer collaboration.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.42,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#615f56"
            }
          ]
        },
        {
          "type": "text",
          "id": "n154",
          "name": "Can you keep looking after it?",
          "x": 120.0,
          "y": 3470.0,
          "width": 535.0,
          "height": 30.0,
          "content": "Can you keep looking after it?",
          "fontFamily": "Geist",
          "fontSize": 20.0,
          "fontWeight": 500,
          "lineHeight": 1.35,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#18211d"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "n153",
          "name": "FAQ 3 rule",
          "x": 120.0,
          "y": 3454.0,
          "width": 535.0,
          "height": 1.0,
          "cornerRadius": 0.0,
          "fill": [
            {
              "type": "solid",
              "color": "#b5c6b7"
            }
          ],
          "children": []
        },
        {
          "type": "text",
          "id": "n152",
          "name": "FAQ 2 answer",
          "x": 120.0,
          "y": 3273.0,
          "width": 535.0,
          "height": 171.0,
          "content": "The code, data access, integrations and the things that could go wrong. We agree the scope, fix relevant findings and check the changes again. Instructions alone don’t enforce permissions, and a review isn’t a guarantee that nothing can go wrong.",
          "fontFamily": "Geist",
          "fontSize": 16.0,
          "fontWeight": 400,
          "lineHeight": 1.42,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#615f56"
            }
          ]
        },
        {
          "type": "text",
          "id": "n151",
          "name": "What do you check?",
          "x": 120.0,
          "y": 3230.0,
          "width": 535.0,
          "height": 30.0,
          "content": "What do you check?",
          "fontFamily": "Geist",
          "fontSize": 20.0,
          "fontWeight": 500,
          "lineHeight": 1.35,
          "textGrowth": "fixed-width-height",
          "fill": [
            {
              "type": "solid",
              "color": "#18211d"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "n150",
          "name": "FAQ 2 rule",
          "x": 120.0,
          "y": 3214.0,
          "width": 535.0,
          "height": 1.0,
          "cornerRadius": 0.0,
          "fill": [
            {
              "type": "solid",
